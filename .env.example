# Copy to .env and adjust. All settings use the SENTINEL_ prefix (see app/core/config.py).
SENTINEL_ENVIRONMENT=development
SENTINEL_LOG_LEVEL=INFO
SENTINEL_LOG_JSON=true

# Local run outside Docker (compose overrides this for the api container)
SENTINEL_DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@localhost:5432/sentinel

# Protect write endpoints: clients send `X-API-Key: <value>`
# SENTINEL_API_KEY=change-me

# Email alerts: each endpoint has its own alert contacts (set in the UI).
# Option A - Brevo (HTTPS API, free 300/day, works on Render free tier):
# SENTINEL_EMAIL_PROVIDER=brevo
# SENTINEL_BREVO_API_KEY=xkeysib-...
# SENTINEL_EMAIL_FROM=you@gmail.com          # verified sender in Brevo
# Option B - SMTP (local / self-hosted; e.g. Gmail with an app password):
# SENTINEL_EMAIL_PROVIDER=smtp
# SENTINEL_SMTP_HOST=smtp.gmail.com
# SENTINEL_SMTP_PORT=587
# SENTINEL_SMTP_USERNAME=you@gmail.com
# SENTINEL_SMTP_PASSWORD=your-16-char-app-password
# SENTINEL_EMAIL_FROM=you@gmail.com
# Optional: also send every alert to this address
# SENTINEL_ALERT_EMAIL_TO=you@gmail.com

# Slack / Discord incoming webhook for alerts
# SENTINEL_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
SENTINEL_ALERT_FAILURE_THRESHOLD=2
SENTINEL_ALERT_COOLDOWN_SECONDS=900

SENTINEL_MAX_CONCURRENT_CHECKS=100
SENTINEL_SCHEDULER_TICK_SECONDS=2
SENTINEL_RETENTION_DAYS=30

SENTINEL_ANOMALY_WINDOW=50
SENTINEL_ANOMALY_MIN_SAMPLES=10
SENTINEL_ANOMALY_THRESHOLD=3.5
